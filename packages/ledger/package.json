{
  "name": "@causalledger/ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "test": "vitest run --exclude \"dist/**\" --exclude \"test/ledger-storage-postgres.test.ts\" --exclude \"test/ledger-account-balance-postgres.test.ts\" --exclude \"test/ledger-transaction-query-postgres.test.ts\" --exclude \"test/ledger-idempotency-postgres.test.ts\" --exclude \"test/ledger-reversal-postgres.test.ts\" --exclude \"test/cash-clearing-account-postgres.test.ts\"",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"README.md\" \"package.json\" \"tsconfig*.json\""
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/pg": "8.20.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "pg": "8.22.0"
  }
}
